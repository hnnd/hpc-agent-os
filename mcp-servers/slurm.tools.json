[
  {
    "name": "cluster_summary",
    "description": "Read timestamped aggregate cluster resources; errors never imply zero capacity.",
    "inputSchema": {
      "type": "object",
      "$defs": {
        "ClusterRequest": {
          "additionalProperties": false,
          "properties": {
            "cluster_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "title": "Cluster Id",
              "type": "string"
            }
          },
          "required": [
            "cluster_id"
          ],
          "title": "ClusterRequest",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/ClusterRequest"
        }
      },
      "required": [
        "request"
      ],
      "title": "cluster_summaryArguments"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "cluster_summaryDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_nodes",
