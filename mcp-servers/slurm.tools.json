              "type": "string"
            },
            "cursor": {
              "anyOf": [
                {
                  "pattern": "^(0|[1-9][0-9]{0,8})$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cursor"
            },
            "limit": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "state": {
              "anyOf": [
                {
                  "enum": [
                    "IDLE",
                    "ALLOCATED",
                    "MIXED",
                    "DOWN",
                    "DRAIN",
                    "UNKNOWN"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "State"
            }
          },
          "required": [
            "cluster_id"
          ],
          "title": "NodeRequest",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/NodeRequest"
