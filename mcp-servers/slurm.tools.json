      "required": [
        "request"
      ],
      "title": "list_nodesArguments"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "list_nodesDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
