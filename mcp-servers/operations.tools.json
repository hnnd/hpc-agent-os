[
  {
    "name": "prepare_operation",
    "description": "Create an immutable operation plan. Owner job and maintenance execution follow their separate configured policies.",
    "inputSchema": {
      "type": "object",
      "$defs": {
        "OperationRequest": {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "enum": [
                "job.submit",
                "job.cancel",
                "software.install",
                "database.update"
              ],
              "title": "Operation",
              "type": "string"
            },
            "idempotency_key": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
              "title": "Idempotency Key",
              "type": "string"
            },
            "script_path": {
              "anyOf": [
                {
                  "maxLength": 1024,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Script Path"
            },
            "script_sha256": {
              "anyOf": [
                {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Script Sha256"
            },
            "job_id": {
              "anyOf": [
                {
                  "pattern": "^[1-9][0-9]{0,17}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Job Id"
            },
            "recipe_id": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Recipe Id"
            },
            "resources": {
              "$ref": "#/$defs/Resources"
            }
          },
          "required": [
            "operation",
            "idempotency_key"
          ],
          "title": "OperationRequest",
          "type": "object"
        },
        "Resources": {
          "additionalProperties": false,
          "properties": {
            "partition": {
              "default": "cpu",
              "enum": [
                "cpu",
                "fat"
              ],
              "title": "Partition",
              "type": "string"
            },
            "cpus": {
              "default": 1,
              "maximum": 8,
              "minimum": 1,
              "title": "Cpus",
              "type": "integer"
            },
            "memory_mib": {
              "default": 1024,
              "maximum": 16384,
              "minimum": 256,
              "title": "Memory Mib",
              "type": "integer"
            },
            "minutes": {
              "default": 10,
              "maximum": 120,
              "minimum": 1,
              "title": "Minutes",
              "type": "integer"
            }
          },
          "title": "Resources",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/OperationRequest"
        }
      },
      "required": [
        "request"
      ],
      "title": "prepare_operationArguments"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "prepare_operationDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_operation",
    "description": "Read own persisted proposal, approval execution state and result; submitted does not mean completed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "get_operationArguments"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "get_operationDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_operation_recipes",
    "description": "List reviewed software/database recipes. Empty means enrollment is still required.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "title": "list_operation_recipesArguments"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "list_operation_recipesDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "execute_maintenance",
    "description": "Execute own enrolled software/database plan without human approval when owner policy allows. Never executes job submit/cancel plans. Do not retry uncertain execution.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "execute_maintenanceArguments"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "execute_maintenanceDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "execute_my_job",
    "description": "Submit or cancel only this OS user's job plan without human approval under owner policy. Cancellation is irreversible. Never executes maintenance; never retry uncertain execution.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "execute_my_jobArguments"
    },
    "outputSchema": {
      "additionalProperties": true,
      "title": "execute_my_jobDictOutput",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
  }
]
