{
  "$defs": {
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Error",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "INVALID_ARGUMENT",
        "FORBIDDEN",
        "UNAVAILABLE",
        "TIMEOUT",
        "OUTPUT_LIMIT",
        "PARSE_ERROR",
        "STALE_DATA"
      ],
      "title": "ErrorCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "cluster_id": {
      "title": "Cluster Id",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed At"
    },
    "stale": {
      "default": false,
      "title": "Stale",
      "type": "boolean"
    },
    "data": {
      "default": null,
      "title": "Data"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Error"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "cluster_id",
    "source"
  ],
  "title": "Response",
  "type": "object"
}
